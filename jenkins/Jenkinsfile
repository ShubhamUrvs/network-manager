pipeline {
    agent any
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build & Test Backend') {
            steps {
                dir('backend') {
                    script {
                        if (isUnix()) {
                            sh 'mvn clean package'
                        } else {
                            // On Windows, use 'bat'. Ensure Maven (mvn) is in your PATH
                            bat 'mvn clean package'
                        }
                    }
                }
            }
        }

        stage('Docker Build & Deploy') {
            when {
                expression { 
                    return env.GIT_BRANCH?.contains('main') || env.GIT_BRANCH?.contains('develop') || env.BRANCH_NAME?.contains('main') || env.BRANCH_NAME?.contains('develop')
                }
            }
            steps {
                script {
                    if (isUnix()) {
                        sh 'docker compose down --remove-orphans'
                        // Forcefully stop any container using project ports, ignore errors if none found
                        sh 'docker ps -q --filter "publish=5433" --filter "publish=8082" --filter "publish=3001" | xargs -r docker stop || true'
                        sh 'docker compose build'
                        sh 'docker compose up -d'
                    } else {
                        // On Windows - Robustly handle empty results to avoid exit code 1
                        bat 'docker compose down --remove-orphans'
                        bat '''
                            @echo off
                            for /f "tokens=*" %%i in (\'docker ps -q --filter "publish=5433" --filter "publish=8082" --filter "publish=3001"\') do (
                                echo Stopping container %%i
                                docker stop %%i
                            )
                            exit /b 0
                        '''
                        bat 'docker compose build'
                        bat 'docker compose up -d'
                    }
                }
            }
        }
    }
    
    post {
        success {
            echo 'Build and Deployment Successful!'
        }
        failure {
            echo 'Build or Deployment Failed. Please check the "Console Output" in Jenkins for the error message.'
        }
        always {
            cleanWs()
        }
    }
}
